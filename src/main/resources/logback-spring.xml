<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot's normal console logging, unchanged -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- security events only (logger "SECURITY", see SecurityMonitor): one key=value line per event,
         a new file every day, the last 30 days kept. One event per line = easy to grep, count and import. -->
    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/security-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- also goes to the console (additivity stays on), so a developer sees the events while working -->
    <logger name="SECURITY" level="INFO">
        <appender-ref ref="SECURITY_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
