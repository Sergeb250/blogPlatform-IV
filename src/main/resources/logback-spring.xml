<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot's normal console logging, unchanged -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Retention policy of both log files below:
         - a new file every day: at midnight today's file is renamed with its date (security-2026-11-20.log)
         - files older than KEEP_DAYS days are deleted
         - all files of one log together stay under TOTAL_SIZE_CAP: when they grow past it, the oldest go first
         - old files are also deleted at startup, in case the app was not running at midnight -->
    <property name="LOG_DIR" value="logs"/>
    <property name="KEEP_DAYS" value="30"/>
    <property name="TOTAL_SIZE_CAP" value="1GB"/>

    <!-- security events (logger "SECURITY", see SecurityEventAspect): logins, rejected tokens, 401 / 403, logouts.
         One key=value line per event = easy to grep, count and import. -->
    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/security-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${KEEP_DAYS}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- every /api/ request (logger "ACCESS", see SecurityEventAspect.recordRequest): who, from which IP, what -->
    <appender name="ACCESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/access.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/access-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${KEEP_DAYS}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- security events also go to the console (additivity stays on), so a developer sees them while working -->
    <logger name="SECURITY" level="INFO">
        <appender-ref ref="SECURITY_FILE"/>
    </logger>

    <!-- requests go to their file only: one console line per request would bury everything else -->
    <logger name="ACCESS" level="INFO" additivity="false">
        <appender-ref ref="ACCESS_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
