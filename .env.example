# Copy this file to .env (git-ignored) and fill it in. application.properties imports .env, so every run started
# from the project folder reads it. A real environment variable with the same name wins.

# start with Google login on when no profile is chosen (remove the line to start without it)
spring.profiles.default=google

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# the first admin account, created at startup while there is no admin yet: 8+ characters
ADMIN_PASSWORD=

# optional, see README 3.2
#DB_PASSWORD=
#JWT_SECRET=
